NEXT_PUBLIC_SITE_URL=https://montavia.ge

# --- Contact form delivery -------------------------------------------------
# SMTP (tried first when set): send through the mailbox provider.
#   SMTP_USER / SMTP_PASS are the mailbox login. SMTP_PORT defaults to 465 (SSL).
#   CONTACT_FROM should be the same address as SMTP_USER.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option A: Resend. All three are required together.
#   CONTACT_TO accepts a comma-separated list.
#   CONTACT_FROM must be an address on a domain you have verified with Resend.
RESEND_API_KEY=
CONTACT_TO=hello@montavia.ge
CONTACT_FROM=Montavia <hello@montavia.ge>

# Option B: POST the submission as JSON anywhere (Zapier, Make, your own API).
CONTACT_WEBHOOK_URL=

# With neither configured the form logs to the server console in development
# and returns an error in production, rather than reporting a false success.
